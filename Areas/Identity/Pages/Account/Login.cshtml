@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
}

<div class="auth-page">

    <div class="container py-5">

        <div class="row justify-content-center">

            <div class="col-md-6 col-lg-5">

                <div class="card auth-card">

                    <div class="text-center auth-header">

                        <div class="auth-icon">
                            🍰
                        </div>

                        <h2 class="fw-bold mb-1">
                            Welcome Back!
                        </h2>

                        <p class="mb-0">
                            Login to your SweetBakery account
                        </p>

                    </div>

                    <div class="card-body p-4 p-md-5">

                        <form id="account"
                              method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3"
                                 role="alert">
                            </div>

                            <div class="form-floating mb-3">

                                <input asp-for="Input.Email"
                                       class="form-control"
                                       autocomplete="username"
                                       aria-required="true"
                                       placeholder="name@example.com" />

                                <label asp-for="Input.Email">
                                    Email Address
                                </label>

                                <span asp-validation-for="Input.Email"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="form-floating mb-3">

                                <input asp-for="Input.Password"
                                       class="form-control"
                                       autocomplete="current-password"
                                       aria-required="true"
                                       placeholder="Password" />

                                <label asp-for="Input.Password">
                                    Password
                                </label>

                                <span asp-validation-for="Input.Password"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-4">

                                <div class="form-check">

                                    <input class="form-check-input"
                                           asp-for="Input.RememberMe" />

                                    <label class="form-check-label"
                                           asp-for="Input.RememberMe">
                                        Remember me
                                    </label>

                                </div>

                                <a asp-page="./ForgotPassword"
                                   class="auth-link text-decoration-none">
                                    Forgot password?
                                </a>

                            </div>

                            <button id="login-submit"
                                    type="submit"
                                    class="btn auth-button btn-lg w-100">
                                🔐 Login
                            </button>

                        </form>

                        <div class="text-center my-4">

                            <span class="text-muted">
                                Don't have an account?
                            </span>

                            <a asp-page="./Register"
                               class="auth-link text-decoration-none">
                                Create one
                            </a>

                        </div>

                        <div class="text-center">

                            <a asp-controller="Home"
                               asp-action="Index"
                               class="auth-back text-decoration-none">
                                ← Back to SweetBakery
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}