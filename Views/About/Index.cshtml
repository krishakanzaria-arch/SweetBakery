@{
    ViewData["Title"] = "About Us";
}

<div class="container mt-4">

    <!-- Header -->

    <div class="text-center mb-5">

        <h1>
            🍰 About SweetBakery
        </h1>

        <p class="lead text-muted">
            Making every celebration a little sweeter.
        </p>

    </div>


    <!-- About -->

    <div class="row align-items-center mb-5">

        <div class="col-md-6">

            <div class="text-center bg-light rounded-4 p-5">

                <div style="font-size: 120px;">
                    🧁
                </div>

                <h3 class="mt-3">
                    Fresh • Delicious • Sweet
                </h3>

            </div>

        </div>

        <div class="col-md-6 mt-4 mt-md-0">

            <h2>
                Our Story
            </h2>

            <p class="text-muted">
                SweetBakery is an online bakery platform created
                to make it simple for customers to discover
                delicious bakery products and place orders online.
            </p>

            <p class="text-muted">
                From cakes and pastries to other sweet treats,
                SweetBakery brings a convenient online shopping
                experience together with the joy of freshly baked
                products.
            </p>

            <p class="text-muted">
                Our goal is to make ordering your favourite bakery
                products easy, convenient and enjoyable.
            </p>

        </div>

    </div>


    <!-- Mission -->

    <div class="row g-4 mb-5">

        <div class="col-md-4">

            <div class="card shadow-sm h-100 text-center">

                <div class="card-body p-4">

                    <div style="font-size: 50px;">
                        ❤️
                    </div>

                    <h4 class="mt-3">
                        Our Mission
                    </h4>

                    <p class="text-muted">
                        To provide customers with a simple and
                        enjoyable online bakery shopping experience.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card shadow-sm h-100 text-center">

                <div class="card-body p-4">

                    <div style="font-size: 50px;">
                        ✨
                    </div>

                    <h4 class="mt-3">
                        Quality
                    </h4>

                    <p class="text-muted">
                        We focus on presenting bakery products with
                        clear information, pricing and availability.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card shadow-sm h-100 text-center">

                <div class="card-body p-4">

                    <div style="font-size: 50px;">
                        🛍️
                    </div>

                    <h4 class="mt-3">
                        Convenience
                    </h4>

                    <p class="text-muted">
                        Browse products, manage your cart and place
                        orders conveniently from one platform.
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- What We Offer -->

    <div class="card shadow-sm mb-5">

        <div class="card-body p-5">

            <div class="text-center mb-4">

                <h2>
                    What We Offer
                </h2>

            </div>

            <div class="row g-4">

                <div class="col-md-3 text-center">

                    <div style="font-size: 45px;">
                        🎂
                    </div>

                    <h5 class="mt-2">
                        Cakes
                    </h5>

                    <p class="text-muted">
                        Delicious cakes for special occasions.
                    </p>

                </div>


                <div class="col-md-3 text-center">

                    <div style="font-size: 45px;">
                        🧁
                    </div>

                    <h5 class="mt-2">
                        Pastries
                    </h5>

                    <p class="text-muted">
                        Sweet treats for every mood.
                    </p>

                </div>


                <div class="col-md-3 text-center">

                    <div style="font-size: 45px;">
                        🍪
                    </div>

                    <h5 class="mt-2">
                        Bakery Treats
                    </h5>

                    <p class="text-muted">
                        A variety of tasty bakery products.
                    </p>

                </div>


                <div class="col-md-3 text-center">

                    <div style="font-size: 45px;">
                        🚚
                    </div>

                    <h5 class="mt-2">
                        Easy Ordering
                    </h5>

                    <p class="text-muted">
                        Simple cart and checkout experience.
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- CTA -->

    <div class="bg-light rounded-4 text-center p-5 mb-5">

        <h2>
            Ready to explore SweetBakery? 🍰
        </h2>

        <p class="text-muted mt-3">
            Discover our delicious collection today.
        </p>

        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-primary btn-lg mt-2">
            Explore Products
        </a>

    </div>

</div>